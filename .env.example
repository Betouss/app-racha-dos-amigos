# Copie para .env.local e preencha com os dados do app web no Console do Firebase
# (Configurações do projeto → Seus apps → SDK setup and configuration → Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_APP_ID=

# true = usa os emuladores locais (npm run emuladores) em vez do projeto real
VITE_FIREBASE_EMULATORS=false
